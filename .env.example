# ===== Telegram (crie em https://my.telegram.org -> API development tools) =====
TG_API_ID=
TG_API_HASH=
# Nome do arquivo de sessão (criado no primeiro login, pede telefone + código)
TG_SESSION=tg_session
# Canal/grupo das tips: @username, link de convite, ou ID numérico (use tools/list_chats.py para descobrir)
TG_CHANNEL=
# Onde o robô te avisa (por padrão, "Mensagens Salvas" da sua própria conta)
TG_NOTIFY=me

# Casa de apostas usada (ver bot/casas/__init__.py)
CASA=pinnacle

# ===== Pinnacle (fica só no SEU computador; nunca envie este arquivo para ninguém) =====
PINNACLE_USER=
PINNACLE_PASS=

# ===== Gmail (para ler o código de login que a Pinnacle manda por e-mail) =====
# Use uma "senha de app" do Google (16 letras), NÃO a sua senha normal. Passo a passo no README.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== Dinheiro =====
# Valor de 1 unidade em reais (banca / 40). Para teste use 2.
UNIT_VALUE=350
# Cada tip adicional do mesmo jogo soma isto (em unidades)
EXTRA_TIP_UNITS=0.25
# Teto por aposta e teto de total apostado por dia (em reais)
MAX_STAKE=500
DAILY_MAX_TOTAL=2000

# ===== Segurança =====
# true = NUNCA confirma aposta: monta o cupom, digita o valor, confere a odd e limpa.
DRY_RUN=true

# ===== Regras de tempo =====
# Ignora tip mais velha que isto (segundos)
MAX_TIP_AGE_S=600
# Encerra quando a linha da tip some da tela (sai gol) por este tempo seguido (s). Trancar por instantes é normal.
LINE_GONE_S=60
# Fecha o navegador depois de X minutos sem nenhum jogo em andamento (reabre e reloga na próxima tip)
IDLE_CLOSE_MIN=20
# Para de monitorar quando o jogo passar deste minuto
GIVE_UP_MINUTE=88
# Tempo máximo de monitoramento por tip (segundos)
MONITOR_TIMEOUT_S=2700
# Se o cancelamento vier sem "responder" a tip, vale para a última tip recebida nesta janela (s)
CANCEL_WINDOW_S=180
# Exige conferir placar/linha da tela com o da tip antes de apostar
REQUIRE_SCORE_CHECK=true
# Similaridade mínima (0-1) entre nome do time da tip e da Pinnacle
MATCH_THRESHOLD=0.70

# ===== Navegador =====
# "chrome" usa o Chrome instalado; deixe vazio para usar o Chromium do Playwright
CHROME_CHANNEL=chrome
HEADLESS=false
PROFILE_DIR=browser_profile
# true = cada execução abre um Chrome NOVO, sem login/cookies de antes (apagado ao fechar). false = reaproveita PROFILE_DIR
FRESH_SESSION=true
# Tamanho da janela (o layout mapeado é o de largura estreita)
VIEWPORT_W=440
VIEWPORT_H=940
# Segundos esperando você resolver 2FA/verificação manualmente
MANUAL_INTERVENTION_TIMEOUT_S=600
# Intervalo entre leituras de odd (segundos, aleatório entre min e max)
POLL_MIN_S=2.0
POLL_MAX_S=4.5

STATE_DB=state.sqlite3
LOG_LEVEL=INFO
